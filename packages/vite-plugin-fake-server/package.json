{
	"name": "vite-plugin-fake-server-turbo",
	"version": "3.0.17",
	"description": "A fake server plugin for Vite.",
	"keywords": [
		"faker-server",
		"vite-plugin-fake",
		"vite-plugin-fake-server",
		"vite-plugin-faker",
		"vite-plugin-mock",
		"vite-plugin-mock-server"
	],
	"homepage": "https://github.com/condorheroblog/vite-plugin-fake-server/blob/main/README.md",
	"bugs": {
		"url": "https://github.com/condorheroblog/vite-plugin-fake-server/issues"
	},
	"license": "MIT",
	"author": "Condor Hero",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/condorheroblog/vite-plugin-fake-server.git",
		"directory": "packages/vite-plugin-fake-server"
	},
	"files": [
		"dist",
		"dist-res"
	],
	"type": "module",
	"main": "dist/index.cjs",
	"module": "dist/index.mjs",
	"types": "dist/index.d.cts",
	"typesVersions": {
		"*": {
			"*": [
				"./dist/*",
				"./dist/index.d.ts"
			]
		}
	},
	"exports": {
		".": {
			"require": "./dist/index.cjs",
			"import": "./dist/index.mjs"
		},
		"./client": {
			"require": "./dist/client.cjs",
			"import": "./dist/client.mjs"
		}
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org"
	},
	"scripts": {
		"prepublishOnly": "npm run build",
		"test": "vitest",
		"dev": "esno ./src/index.ts",
		"build": "rimraf dist && rollup -c",
		"build:watch": "rimraf dist && rollup -c -w",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"bundle-import": "^0.0.2",
		"chokidar": "^4.0.3",
		"cors": "^2.8.5",
		"esbuild": "0.25.2",
		"fast-glob": "^3.3.2",
		"path-to-regexp": "^8.3.0",
		"picocolors": "^1.1.1"
	},
	"devDependencies": {
		"vite": "^7.1.12"
	}
}
